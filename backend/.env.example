APP_ENV=production
CORS_ORIGINS=http://localhost:3000

# Hugging Face Inference Providers API (server-side only)
HF_TOKEN=hf_your_server_side_token

# Model hosted on the Hugging Face Hub
HF_MODEL_ID=openai/whisper-large-v3-turbo

# hf-inference = Hugging Face Inference API (serverless)
HF_PROVIDER=hf-inference

MAX_AUDIO_MB=25
HF_TIMEOUT_SECONDS=30
